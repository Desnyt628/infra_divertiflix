# Copy to terraform.tfvars (git-ignored).
# The API token goes in the environment, never in this file:
#   export TF_VAR_proxmox_api_token='terraform@pve!provider=<secret>'

proxmox_api_endpoint = "https://192.168.0.2:8006"
proxmox_node         = "proxmax"

datastore_images   = "local"
datastore_snippets = "local"
datastore_vm       = "local-lvm"

vm_name          = "docker-host"
vm_cores         = 4
vm_memory        = 16384
vm_media_disk_gb = 500

vm_ipv4_address = "192.168.8.240/24"
vm_gateway      = "192.168.8.1"
domain          = "home.arpa"


# DNS servers given to the VM by cloud-init (used until the dns role takes over).
# Point them at your local resolver if the network requires it, for example:
#   vm_dns_servers = ["192.168.8.1"]
vm_dns_servers = ["1.1.1.1", "8.8.8.8"]