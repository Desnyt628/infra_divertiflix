---
# Copy to vault.yml, fill in real values, then: ansible-vault encrypt vault.yml
step_ca_password: CHANGE_ME
immich_db_password: CHANGE_ME
glpi_db_password: CHANGE_ME
glpi_db_root_password: CHANGE_ME
bookstack_db_password: CHANGE_ME
bookstack_db_root_password: CHANGE_ME
bookstack_app_key: CHANGE_ME          # format base64:...
vaultwarden_admin_token: CHANGE_ME
homarr_encryption_key: CHANGE_ME
mullvad_private_key: CHANGE_ME
mullvad_addresses: CHANGE_ME
ntfy_admin_user: CHANGE_ME
ntfy_admin_password_hash: CHANGE_ME   # bcrypt hash
vault_xray_vpn_gateway_uuid: "CHANGE_ME_UUID"
vault_xray_vpn_gateway_reality_public_key: "CHANGE_ME_PUBKEY"
vault_xray_vpn_gateway_reality_short_id: "CHANGE_ME_SHORTID"
vault_xray_vpn_gateway_ovpn_client_config: |
  CHANGE_ME_FULL_OVPN_CLIENT_CONFIG
  # paste the whole .ovpn here (client, remote 127.0.0.1 1194, proto tcp,
  # <ca>/<cert>/<key>/<tls-auth> inline blocks), indented under this key