services:
  sonarr:
    image: {{ images.sonarr }}
    container_name: sonarr
    restart: unless-stopped
    environment:
      PUID: "{{ puid }}"
      PGID: "{{ pgid }}"
      TZ: {{ timezone }}
    volumes:
      - {{ data_dir }}/sonarr/config:/config
      - {{ storage_dir }}:/data
    networks:
      {{ docker_network_name }}:
        ipv4_address: {{ services.sonarr.ip }}
    dns:
      - {{ services.dns.ip }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.sonarr.rule=Host(`sonarr.{{ domain }}`)"
      - "traefik.http.routers.sonarr.entrypoints=websecure"
      - "traefik.http.routers.sonarr.tls=true"
      - "traefik.http.routers.sonarr.tls.certresolver=step-ca"
      - "traefik.http.services.sonarr.loadbalancer.server.port={{ services.sonarr.port }}"

networks:
  {{ docker_network_name }}:
    external: true
